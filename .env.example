# .env.example — Copy เป็น .env และใส่ค่าจริง (ห้าม commit .env เข้า Git)

# ngrok Auth Token (สำหรับเปิด MLflow UI จาก Colab)
# ดาวน์โหลดได้จาก https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here

# MLflow Tracking URI (override ค่าใน base.yaml)
# MLFLOW_TRACKING_URI=sqlite:///runs/mlruns.db
